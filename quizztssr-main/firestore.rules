rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Document vide : présence = admin (UID = ID du doc). Création uniquement via Console / CLI.
    match /admins/{adminUid} {
      allow read: if request.auth != null && request.auth.uid == adminUid;
      allow write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == entryId
        && (!('totalPlayed' in request.resource.data) || request.resource.data.totalPlayed is number)
        && (!('totalCorrect' in request.resource.data) || request.resource.data.totalCorrect is number)
        && (!('mastered' in request.resource.data) || request.resource.data.mastered is number)
        && (!('streak' in request.resource.data) || request.resource.data.streak is number)
        && (!('badges' in request.resource.data) || request.resource.data.badges is number);
      allow delete: if isAdmin();
    }

    match /promos/{promoId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      // Seul le propriétaire peut modifier la promo librement.
      // Les autres ne peuvent que s'ajouter à la liste des membres.
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.auth.uid in request.resource.data.members
        )
      );
      allow delete: if isAdmin();
    }

    match /duels/{duelId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host.uid == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow update: if request.auth != null && (
        resource.data.host.uid == request.auth.uid ||
        (resource.data.guest != null && resource.data.guest.uid == request.auth.uid) ||
        (
          (!('guest' in resource.data) || resource.data.guest == null)
          && request.resource.data.guest.uid == request.auth.uid
          && resource.data.status == 'waiting'
        )
      );
      allow delete: if request.auth != null && resource.data.host.uid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /question_stats/{questionId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }
  }
}
